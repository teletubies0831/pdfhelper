diff --git a/build/pdf.mjs b/build/pdf.mjs
index 3b08593dd20d37f9679d0ba0f7999ad96d393682..db2c18fa197544ad7b954863d97be065802e3497 100644
--- a/build/pdf.mjs
+++ b/build/pdf.mjs
@@ -14701,6 +14701,13 @@ class TextLayer {
     const ascent = metrics.fontBoundingBoxAscent;
     const descent = Math.abs(metrics.fontBoundingBoxDescent);
     ctx.canvas.width = ctx.canvas.height = 0;
+    // Resizing a canvas resets its drawing state, including `ctx.font`.
+    // Invalidate the matching cache entry so the next text-width measurement
+    // restores the requested font instead of measuring with the 10px default.
+    this.#canvasCtxFonts.set(ctx, {
+      size: 0,
+      family: ""
+    });
     let ratio = 0.8;
     if (ascent) {
       ratio = ascent / (ascent + descent);
diff --git a/build/pdf.worker.mjs b/build/pdf.worker.mjs
index 7d85fb9b157e751bdf05d7a6d3a12d29f161bded..e5c83e6ab60f2838a1be74350d6e2f4e07e38887 100644
--- a/build/pdf.worker.mjs
+++ b/build/pdf.worker.mjs
@@ -35289,7 +35289,11 @@ class PartialEvaluator {
       if (!seenStyles.has(loadedName)) {
         seenStyles.add(loadedName);
         textContent.styles[loadedName] = {
-          fontFamily: font.fallbackName,
+          // Canvas rendering has already registered the PDF font under this
+          // generated family name. Reuse it in the text layer so per-character
+          // advances match the visible glyphs; retain the generic family for
+          // documents whose embedded font cannot be loaded by the browser.
+          fontFamily: `"${loadedName}", ${font.fallbackName}`,
           ascent: font.ascent,
           descent: font.descent,
           vertical: font.vertical
